#!/usr/bin/env bash
# Liga/desliga skill do PadraoAI SÓ num projeto (Claude, DeepSeek e Antigravity leem estas pastas).
# Uso: skill-on <nome> [projeto=.]    |    skill-off <nome> [projeto=.]
set -euo pipefail
AQUI=$(cd "$(dirname "$0")/.." && pwd)
modo=$(basename "$0"); nome=${1:?uso: $modo <skill> [projeto]}; proj=$(cd "${2:-.}" && pwd)
for base in .claude/skills .agents/skills; do
  if [ "$modo" = skill-on ]; then
    src=$(ls -d "$AQUI"/skills/"$nome" "$AQUI"/extras/skills/"$nome" 2>/dev/null | head -1 || true)
    [ -n "$src" ] || { echo "skill '$nome' não existe no catálogo" >&2; exit 1; }
    mkdir -p "$proj/$base" && ln -sfn "$src" "$proj/$base/$nome"
  else
    rm -f "$proj/$base/$nome"
  fi
done
echo "$modo $nome em $proj"
