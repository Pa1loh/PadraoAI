{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/bloqueia-segredos.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/bloqueia-comandos.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/valida-issue.sh"
          }
        ]
      }
    ]
  }
}
